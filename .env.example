# Created by Vercel CLI
SUPPORT_EMAIL="support@tsukurist.com"
NOREPLY_EMAIL="noreply@tsukurist.com"
# アプリの公開URL（末尾スラッシュ・パスなし）。プッシュ通知のリンク先にも使われる
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID="price_xxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
NEXT_PUBLIC_STRIPE_STANDARD_PRICE_ID="price_xxxxx"
STRIPE_PREMIUM_PRICE_ID="price_xxxxx"
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_STANDARD_PRICE_ID="price_xxxxx"
# Stripe Dashboardで設定した、プラン変更の日割り計算に対応するCustomer PortalのConfiguration ID
STRIPE_BILLING_PORTAL_CONFIGURATION_ID="bpc_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"

# Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# Resend
RESEND_API_KEY="xxxxx"

# Vercel
VERCEL_OIDC_TOKEN="xxxxx"

# Cron
# 納期通知Cron（/api/cron/deadline-notify）の認証用シークレット。外部サービスから発行されるものではなく、自分で生成する。
# Cronは Cloudflare Workers（cloudflare/cron-worker/）から呼び出される。詳細は docs/cloudflare-cron.md
#   生成: openssl rand -hex 32
#     （opensslが無ければ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
#   登録（Vercel）: Vercel Dashboard → Project → Settings → Environment Variables → CRON_SECRET（Production と Preview で別の値）
#   登録（Cloudflare）: cd cloudflare/cron-worker && npx wrangler secret put CRON_SECRET --env production|staging
#                       （同じ環境のVercelと同じ値。本番Worker↔Production、検証Worker↔Preview）
#   16文字以上必須。登録・変更後は Vercel を Redeploy すること。
#   wrangler.toml・vercel.json のURLに含めたり、リポジトリにコミットしたりしないこと。
CRON_SECRET="xxxxx"

# 監視（任意）
#   死活監視（Dead man's switch）: Healthchecks.io 等で作成した ping URL。毎時のCronが成功するたびにpingし、
#   一定時間途切れると監視側からメール等で通知される（失敗時は /fail へ通知）。
#   エラー通知メールの宛先は SUPPORT_EMAIL（上記）。
HEALTHCHECKS_PING_URL=""

# ログ（任意。lib/server/logger.ts。詳細は docs/logging-guide.md）
#   すべて未設定でも動作する（本番: INFO以上をコンソールとSupabase app_logsへ出力）。
#   LOG_LEVEL      : 全体の最低レベル。TRACE / DEBUG / INFO / WARN / ERROR / FATAL
#                    （未設定時: 本番=INFO、それ以外=DEBUG）
#   LOG_LEVELS     : ロガー名ごとの上書き（前方一致・長い名前が優先）。例: "stripe=WARN,cron.deadline-notify=DEBUG"
#   LOG_DB_LEVEL   : app_logs に保存する最低レベル（未設定時: INFO）。保存量を減らすなら WARN
#   LOG_DB_ENABLED : "false" で app_logs への保存を無効化（コンソール出力のみ。未設定時: 有効）
LOG_LEVEL=""
LOG_LEVELS=""
LOG_DB_LEVEL=""
LOG_DB_ENABLED=""

# VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxxxx"
VAPID_EMAIL="mailto:support@tsukurist.com"
VAPID_PRIVATE_KEY="xxxxx"
